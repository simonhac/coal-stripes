{
  // The Worker half of the app, checked separately from tsconfig.json.
  //
  // Why the split: worker-configuration.d.ts (generated by `bun run cf-typegen`)
  // replaces the DOM globals with workerd's — under which `Response.json()`
  // returns `unknown` rather than `any`. Applying that to the whole project
  // breaks existing client code. Once Next is gone (Phase 5) these two configs
  // can merge back into one.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "noEmit": true,
    "types": []
  },
  "include": [
    "worker-configuration.d.ts",
    "vite.config.ts",
    "src/router.tsx",
    "src/routeTree.gen.ts",
    "src/routes/**/*.ts",
    "src/routes/**/*.tsx"
  ],
  "exclude": ["node_modules", ".context", "dist", ".wrangler"]
}
