{
  "name": "coal-stripes-viz",
  "version": "0.1.0",
  "private": true,
  "description": "Reference app demonstrating the OpenElectricity API: a 'stripes' visualisation of Australian coal power plant capacity factors",
  "author": "Simon Holmes \u00e0 Court (https://github.com/simonhac)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/simonhac/coal-stripes-viz.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite build && wrangler dev",
    "deploy": "vite build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "build:local": "vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "lint:fix": "eslint . --fix",
    "check": "npm run typecheck && npm run lint",
    "test": "vitest run --project unit --project workers",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest --project unit",
    "test:e2e": "playwright test",
    "postinstall": "CI=1 wrangler types",
    "test:workers": "vitest run --project workers"
  },
  "dependencies": {
    "@internationalized/date": "^3.8.2",
    "@react-spring/web": "^10.0.1",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "1.170.21",
    "@tanstack/react-start": "1.168.38",
    "@use-gesture/react": "^10.3.1",
    "openelectricity": "0.9.1",
    "p-queue": "^9.3.1",
    "p-retry": "^8.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.51.1",
    "@cloudflare/vitest-pool-workers": "^0.20.3",
    "@eslint/js": "^9",
    "@playwright/test": "^1.61.1",
    "@simon/workspace-env": "github:simonhac/workspace-env#v0.1.0",
    "@tanstack/react-query-devtools": "^5.101.2",
    "@types/node": "^20.19.8",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv": "^17.2.0",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "puppeteer": "^24.14.0",
    "tsx": "^4.23.0",
    "typescript": "^5",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4",
    "wrangler": "^4.120.0"
  }
}
