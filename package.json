{
  "name": "coal-stripes-viz",
  "version": "0.1.0",
  "private": true,
  "description": "Reference app demonstrating the OpenElectricity API: a 'stripes' visualisation of Australian coal power plant capacity factors",
  "author": "Simon Holmes à Court (https://github.com/simonhac)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/simonhac/coal-stripes-viz.git"
  },
  "type": "module",
  "scripts": {
    "//": "Next scripts are prefixed `next:` for the duration of the Cloudflare migration; the unprefixed ones are the new Vite/Workers toolchain.",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite build && wrangler dev",
    "deploy": "vite build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "build:local": "vite build && NEXT_DIST_DIR=.next-build next build",
    "next:dev": "next dev --turbopack",
    "next:build": "next build",
    "next:start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "lint:fix": "next lint --fix",
    "check": "npm run typecheck && npm run lint",
    "test": "jest --config jest.config.unit.cjs",
    "test:integration": "jest --config jest.config.integration.cjs",
    "test:watch": "jest --config jest.config.unit.cjs --watch",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@internationalized/date": "^3.8.2",
    "@react-spring/web": "^10.0.1",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "1.170.21",
    "@tanstack/react-start": "1.168.38",
    "@use-gesture/react": "^10.3.1",
    "@vercel/analytics": "^1.5.0",
    "@vercel/functions": "^3.7.6",
    "@vercel/speed-insights": "^1.2.0",
    "next": "15.5.20",
    "openelectricity": "0.9.1",
    "p-queue": "^9.3.1",
    "p-retry": "^8.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.51.1",
    "@playwright/test": "^1.61.1",
    "@simon/workspace-env": "github:simonhac/workspace-env#v0.1.0",
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-query-devtools": "^5.101.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.8",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "@vitejs/plugin-react": "^6.0.5",
    "dotenv": "^17.2.0",
    "eslint": "^9.32.0",
    "eslint-config-next": "^15.5.20",
    "jest": "^30.0.4",
    "puppeteer": "^24.14.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.0",
    "tsx": "^4.23.0",
    "typescript": "^5",
    "vite": "^8.2.1",
    "wrangler": "^4.120.0"
  }
}
