# OpenElectricity API Configuration
# Get a free key at https://openelectricity.org.au
OPENELECTRICITY_API_KEY=your_api_key_here

# Secret authorising POST /api/admin/purge and POST /api/admin/rebuild, and
# the buttons for both on /diagnostics. Unset means nobody is authorised. In
# production this is a Worker secret (`wrangler secret put CACHE_SECRET`),
# not an env var.
CACHE_SECRET=your_purge_secret_here

# Logging Configuration
# Enable file logging for API requests (default: true in development, false in
# production). There is no writable filesystem on Workers — leave it off there.
ENABLE_FILE_LOGGING=true
