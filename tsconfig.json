{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-build/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "forks",
    "env",
    "e2e",
    "playwright.config.ts",
    ".context",
    "dist",
    ".wrangler",
    // The Worker half is checked by tsconfig.worker.json instead. Its
    // `worker-configuration.d.ts` replaces the DOM globals (Response.json()
    // returns unknown, not any), which breaks client code if applied here.
    "src/routes",
    "src/router.tsx",
    "src/routeTree.gen.ts",
    "worker-configuration.d.ts",
    "vite.config.ts"
  ]
}
